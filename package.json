{
  "name": "motora-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "app"
  ],
  "scripts": {
    "test:program": "mocha --timeout 1200000 tests/**/*.ts --require ts-node/register --reporter spec",
    "test": "anchor test",
    "idl:sync": "node scripts/sync-idl.mjs",
    "setup": "bash scripts/setup.sh",
    "deploy:devnet": "bash scripts/deploy-devnet.sh",
    "devnet:init": "ts-node scripts/devnet/init.ts",
    "devnet:integration": "ts-node scripts/devnet/integration.ts",
    "devnet:verify": "ts-node scripts/devnet/verify.ts",
    "devnet:all": "bash scripts/devnet-all.sh",
    "funding:pow:list": "ts-node scripts/funding/pow-faucet.ts list",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run --workspace motora-app typecheck",
    "verify": "npm run typecheck && anchor test --skip-build && npm run --workspace motora-app build"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "mocha": "^11.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
